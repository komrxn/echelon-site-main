    color: var(--machine);
  }

  /*
   * Initial states for everything the choreography animates. Gated on
   * [data-anim], which ONLY the section's own script sets, and only when
   * motion is allowed — no-JS, a failed script and prefers-reduced-motion all
   * read the static final frame with zero fallback rules.
   */
  .soon[data-anim] :is(.o-furn, .o-fig, .o-lab, .o-bub:not(.o-bub--hand), .o-dash, .o-plus),
  .soon[data-anim] :is(.c-furn, .p-g, .c-walk, .c-joint, .p-tag),
  .soon[data-anim] :is([data-report], .soon__detect-chip, .soon__alert) {
    opacity: 0;
  }
</style>

<script>
  import {
    animate,
    createTimeline,
    createDrawable,
    cubicBezier,
    stagger,
    utils,
    type JSAnimation,
  } from 'animejs';

  /* mirrors --ease-enter / --ease-snap from the design tokens */
  const enter = cubicBezier(0.16, 1, 0.3, 1);
  const snap = cubicBezier(0.34, 1.4, 0.64, 1);

  /* Every endless animation registers here; they only tick while the section
     is on screen — no camera scans for nobody. Timelines qualify too, so the
     list is typed by the two methods the visibility switch actually uses. */
  type Pausable = { pause: () => unknown; resume: () => unknown };
  const loops: Pausable[] = [];
  function trackLoops(section: HTMLElement) {
    let visible = true;
    const io = new IntersectionObserver((entries) => {
      const now = entries.some((e) => e.isIntersecting);
      if (now === visible) return;
      visible = now;
      for (const a of loops) (now ? a.resume : a.pause).call(a);
    });
    io.observe(section);
  }

  function once(el: Element, cb: () => void, threshold = 0.25) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        cb();
      },
      { threshold },
    );
    io.observe(el);
  }

  const drawablesOf = (els: Iterable<SVGElement>) =>
    Array.from(els, (el) => {
      const d = createDrawable(el)[0]!;
      utils.set(d, { draw: '0 0' });
      return d;
    });

  /* ---- a) the office ---- */

  const ROUTES: Record<string, Array<{ x: number; y: number }>> = {
    rec: [
      { x: 170, y: 152 },
      { x: 170, y: 110 },
      { x: 500, y: 110 },
      { x: 500, y: 172 },
      { x: 768, y: 172 },
      { x: 768, y: 228 },
    ],
    coder: [
      { x: 452, y: 556 },
      { x: 452, y: 470 },
      { x: 490, y: 446 },
      { x: 490, y: 240 },
      { x: 560, y: 174 },
      { x: 790, y: 174 },
      { x: 790, y: 252 },
    ],
  };

  function courier(
    el: SVGGElement,
    route: Array<{ x: number; y: number }>,
    opts: { delay: number; rest: number; bubble: HTMLElement | null; paper: SVGElement | null },
  ) {
    const inner = el.querySelector<SVGGElement>('.o-wi');
    const legA = el.querySelector<SVGLineElement>('.o-legA');
    const legB = el.querySelector<SVGLineElement>('.o-legB');
    const paperInHand = el.querySelector<SVGRectElement>('.o-paper');
    if (!inner || !legA || !legB || !paperInHand) return;

    utils.set(el, { translateX: route[0]!.x, translateY: route[0]!.y });

    const gaits = [
      animate(legA, { rotate: [-22, 22], duration: 230, alternate: true, loop: true, ease: 'inOutSine', autoplay: false }),
      animate(legB, { rotate: [22, -22], duration: 230, alternate: true, loop: true, ease: 'inOutSine', autoplay: false }),
      animate(inner, { translateY: [0, -1.7], duration: 230, alternate: true, loop: true, ease: 'inOutSine', autoplay: false }),
    ];
    loops.push(...gaits);
    const legsOn = () => gaits.forEach((g) => g.play());
    const legsOff = () => {
      gaits.forEach((g) => g.pause());
      utils.set([legA, legB], { rotate: 0 });
      utils.set(inner, { translateY: 0 });
    };

    const SPEED = 0.185; /* px per ms — an unhurried office walk */
    const leg = (a: { x: number; y: number }, b: { x: number; y: number }) =>
      Math.hypot(b.x - a.x, b.y - a.y) / SPEED;

    const tl = createTimeline({ loop: true, defaults: { ease: 'linear' }, delay: opts.delay, loopDelay: opts.rest });
    route.slice(1).forEach((p, i) => {
      tl.add(el, {
        translateX: p.x,
        translateY: p.y,
        duration: leg(route[i]!, p),
        ...(i === 0 ? { onBegin: legsOn } : {}),
        ...(i === route.length - 2 ? { onComplete: legsOff } : {}),
      });
    });
    tl.add(paperInHand, { opacity: 0, duration: 160 });
    if (opts.paper) tl.add(opts.paper, { opacity: [0, 1], duration: 220 }, '-=80');
    if (opts.bubble) {
      tl.add(opts.bubble, { opacity: [0, 1], translateY: [6, 0], duration: 380, ease: snap }, '-=80')
        .add(opts.bubble, { opacity: 0, duration: 340 }, '+=2500');
    }
    if (opts.paper) tl.add(opts.paper, { opacity: 0, duration: 240 }, '-=240');
    const back = [...route].reverse();
    back.slice(1).forEach((p, i) => {
      tl.add(el, {
        translateX: p.x,
        translateY: p.y,
        duration: leg(back[i]!, p),
        ...(i === 0 ? { onBegin: legsOn } : {}),
        ...(i === back.length - 2 ? { onComplete: legsOff } : {}),
      });
    });
    tl.add(paperInHand, { opacity: 1, duration: 200 });
    loops.push(tl);
  }

  function armOffice(office: HTMLElement) {
    const $$ = <T extends Element>(sel: string) => Array.from(office.querySelectorAll<T>(sel));
    const walls = drawablesOf($$<SVGPathElement>('.o-wall'));
    const furn = $$<SVGGElement>('.o-furn');
    const figs = $$<SVGGElement>('.o-fig');
    const labels = $$<HTMLElement>('.o-lab');
    const bubbles = $$<HTMLElement>('.o-bub:not(.o-bub--hand)');
    const dots = $$<HTMLElement>('.o-dots');
    const texts = $$<HTMLElement>('.o-bub:not(.o-bub--hand) .o-text');
    const reports = $$<HTMLElement>('[data-report]');
    const dash = office.querySelector<SVGPathElement>('.o-dash');
    const plus = office.querySelector<SVGPathElement>('.o-plus');
    const hubdot = office.querySelector<SVGCircleElement>('.o-hubdot');

    const tl = createTimeline({
      autoplay: false,
      defaults: { ease: enter },
      onComplete: () => {
        /* the office comes to life: couriers, idle drift, the constructor plot */
        courier(office.querySelector('[data-courier="rec"]')!, ROUTES.rec!, {
          delay: 600,
          rest: 5200,
          bubble: office.querySelector('[data-handoff="rec"]'),
          paper: office.querySelector('[data-deskpaper="rec"]'),
        });
        courier(office.querySelector('[data-courier="coder"]')!, ROUTES.coder!, {
          delay: 9800,
          rest: 5200,
          bubble: office.querySelector('[data-handoff="coder"]'),
          paper: office.querySelector('[data-deskpaper="coder"]'),
        });
        loops.push(
          animate(bubbles, {
            translateY: [0, -3],
            duration: 1700,
            alternate: true,
            loop: true,
            ease: 'inOutSine',
            delay: stagger(320),
          }),
        );
        if (hubdot) {
          loops.push(
            animate(hubdot, { scale: [1, 1.7], duration: 800, alternate: true, loop: true, ease: 'inOutSine' }),
          );
        }
        if (plus) {
          loops.push(
            animate(plus, { opacity: [1, 0.35], duration: 1200, alternate: true, loop: true, ease: 'inOutSine' }),
          );
        }
      },
    });

    tl.add(walls, { draw: '0 1', duration: 850, delay: stagger(120), ease: 'inOut(2)' })
      .add([dash, plus].filter(Boolean) as SVGPathElement[], { opacity: [0, 1], duration: 450 }, '-=350')
      .add(furn, { opacity: [0, 1], duration: 380, delay: stagger(70) }, '-=450')
      .add(figs, { opacity: [0, 1], scale: [0.6, 1], duration: 430, delay: stagger(90), ease: snap }, '-=250')
      .add(labels, { opacity: [0, 1], duration: 380, delay: stagger(60) }, '-=350')
      .add(bubbles, { opacity: [0, 1], scale: [0.85, 1], translateY: [8, 0], duration: 460, delay: stagger(280), ease: snap }, '-=350')
      /* each bubble types for ~a second, then the message replaces the dots */
      .add(dots, { opacity: [1, 0], duration: 220, delay: stagger(280) }, '-=780')
      .add(texts, { opacity: [0, 1], duration: 300, delay: stagger(280) }, '-=700')
      .add(reports, { opacity: [0, 1], translateY: [10, 0], duration: 430, delay: stagger(140) }, '-=500');

    once(office, () => tl.play());
  }

  /* ---- b) the camera: silhouettes → skeletons → the poses read out ---- */

  function armCam(wrap: HTMLElement) {
    const cam = wrap.querySelector<HTMLElement>('[data-cam]');
    if (!cam) return;
    const $$ = <T extends Element>(sel: string) => Array.from(cam.querySelectorAll<T>(sel));
    const people = $$<SVGGElement>('.p-g');
    const furn = $$<SVGGElement>('.c-furn');
    const walker = cam.querySelector<SVGGElement>('.c-walk');
    const rail = cam.querySelector<SVGGElement>('[data-rail]');
    const qboxEl = cam.querySelector<SVGPathElement>('[data-qbox]');
    const chip = cam.querySelector<HTMLElement>('[data-chip]');
    const countEl = cam.querySelector<HTMLElement>('[data-count]');
    const alertEl = wrap.querySelector<HTMLElement>('[data-alert]');
    const scanline = cam.querySelector<HTMLElement>('[data-scanline]');
    const rec = cam.querySelector<HTMLElement>('[data-rec]');
    if (!walker || !rail || !qboxEl || !chip || !countEl || !alertEl) return;

    const personEls = (name: string) => {
      const root = cam.querySelector<SVGGElement>(`[data-person="${name}"]`)!;
      return {
        root,
        bones: root.querySelectorAll<SVGLineElement>('.c-bone'),
        joints: root.querySelectorAll<SVGCircleElement>('.c-joint'),
        box: root.querySelector<SVGPathElement>('.c-pbox')!,
        tag: root.querySelector<SVGTextElement>('.p-tag')!,
      };
    };
    const cashier = personEls('cashier');
    const phone = personEls('phone');
    const wBones = walker.querySelectorAll<SVGLineElement>('.c-bone');
    const wJoints = walker.querySelectorAll<SVGCircleElement>('.c-joint');
    const wBox = walker.querySelector<SVGPathElement>('.c-pbox')!;
    const wTag = walker.querySelector<SVGTextElement>('.p-tag')!;

    const draw = (els: Iterable<SVGElement>) => drawablesOf(els);
    const dCash = draw(cashier.bones);
    const dPhone = draw(phone.bones);
    const dW = draw(wBones);
    const dBoxes = draw([cashier.box, phone.box, wBox]);
    const dQ = draw([qboxEl])[0]!;

    const setTag = (tag: SVGTextElement, text: string, event = false) => {
      tag.textContent = text;
      tag.classList.toggle('is-event', event);
    };
    const fmt = (t: number) => `${Math.floor(t / 60)}:${String(Math.round(t) % 60).padStart(2, '0')}`;

    /* the walker's gait — driven by the master timeline's callbacks */
    const gaits: JSAnimation[] = [];
    const swing = (sel: string, from: number, to: number, delay = 0) => {
      const parts = walker.querySelectorAll<SVGGElement>(sel);
      if (parts.length) {
        gaits.push(
          animate(parts, { rotate: [from, to], duration: 480, alternate: true, loop: true, ease: 'inOutSine', delay, autoplay: false }),
        );
      }
    };
    swing('.c-leg-l', -26, 26);
    swing('.c-leg-l .c-shin', 4, 40, 120);
    swing('.c-leg-r', 26, -26);
    swing('.c-leg-r .c-shin', 40, 4, 120);
    swing('.c-arm-l', 24, -24);
    swing('.c-arm-r', -24, 24);
    swing('.c-fore', -8, -30, 100);
    const bobEl = walker.querySelector<SVGGElement>('.c-bob');
    if (bobEl) {
      gaits.push(animate(bobEl, { translateY: [0, -2.5], duration: 480, alternate: true, loop: true, ease: 'inOutSine', autoplay: false }));
    }
    loops.push(...gaits);
    const gaitsOn = () => gaits.forEach((g) => g.play());
    const gaitsOff = () => {
      gaits.forEach((g) => g.pause());
      utils.set(walker.querySelectorAll('[data-pivot]'), { rotate: 0 });
      if (bobEl) utils.set(bobEl, { translateY: 0 });
    };

    const timer = { t: 227 };
    const qn = { n: 0 };
    const A = {
      analyzing: (t: SVGTextElement) => t.dataset.analyzing ?? '',
      final: (t: SVGTextElement) => t.dataset.final ?? '',
      walking: wTag.dataset.walking ?? '',
    };

    const M = createTimeline({ autoplay: false, loop: true, loopDelay: 600, defaults: { ease: enter } });

    /* the raw scene: silhouettes only */
    M.add([...people, ...furn], { opacity: [0, 1], duration: 500, delay: stagger(110) }, 0)
      .add(walker, { opacity: [0, 1], duration: 400 }, 300)
      .add(rail, {
        translateX: [1070, 504],
        duration: 6800,
        ease: 'linear',
        onBegin: gaitsOn,
        onComplete: gaitsOff,
      }, 400);

    /* the cashier: skeleton built, pose read → «working» */
    M.add(cashier.joints, { opacity: [0, 1], scale: [0, 1], duration: 220, delay: stagger(50), ease: snap }, 1000)
      .add(dCash, { draw: '0 1', opacity: [0, 1], duration: 170, delay: stagger(70), ease: 'out(2)' }, 1150)
      .add(cashier.box, { opacity: [0, 1], duration: 200 }, 2050);
    M.add(dBoxes[0]!, { draw: '0 1', duration: 420, ease: 'inOut(2)' }, 2050);
    M.add(cashier.tag, {
      opacity: [0, 1],
      duration: 240,
      onBegin: () => setTag(cashier.tag, A.analyzing(cashier.tag)),
    }, 2300);
    M.call(() => setTag(cashier.tag, A.final(cashier.tag)), 3400);

    /* the idle employee: skeleton, pose «on the phone», the timer starts */
    M.add(phone.joints, { opacity: [0, 1], scale: [0, 1], duration: 220, delay: stagger(50), ease: snap }, 2700)
      .add(dPhone, { draw: '0 1', opacity: [0, 1], duration: 170, delay: stagger(70), ease: 'out(2)' }, 2850)
      .add(phone.box, { opacity: [0, 1], duration: 200 }, 3750);
    M.add(dBoxes[1]!, { draw: '0 1', duration: 420, ease: 'inOut(2)' }, 3750);
    M.add(phone.tag, {
      opacity: [0, 1],
      duration: 240,
      onBegin: () => setTag(phone.tag, A.analyzing(phone.tag)),
    }, 4000);
    M.add(timer, {
      t: [227, 253],
      duration: 15600,
      ease: 'linear',
      onUpdate: () => setTag(phone.tag, `${A.final(phone.tag)} · ${fmt(timer.t)}`, true),
    }, 5200);

    /* the walker is tracked on the move */
    M.add(wJoints, { opacity: [0, 1], scale: [0, 1], duration: 200, delay: stagger(40), ease: snap }, 1900)
      .add(dW, { draw: '0 1', opacity: [0, 1], duration: 150, delay: stagger(60), ease: 'out(2)' }, 2050)
      .add(wBox, { opacity: [0, 1], duration: 200 }, 3000);
    M.add(dBoxes[2]!, { draw: '0 1', duration: 420, ease: 'inOut(2)' }, 3000);
    M.add(wTag, {
      opacity: [0, 1],
      duration: 240,
      onBegin: () => setTag(wTag, A.walking),
    }, 3250);

    /* the queue is counted */
    M.add(qboxEl, { opacity: [0, 1], duration: 200 }, 4600);
    M.add(dQ, {
      draw: '0 1',
      duration: 550,
      ease: 'inOut(2)',
      onComplete: () => qboxEl.removeAttribute('stroke-dasharray'),
    }, 4600)
      .add(chip, { opacity: [0, 1], duration: 240 }, 4950)
      .add(qn, {
        n: [0, 3],
        duration: 700,
        ease: 'linear',
        modifier: utils.round(0),
        onUpdate: () => (countEl.textContent = String(qn.n)),
      }, 5000);

    /* he joins: the box widens, the count becomes 4, the pose flips */
    M.call(() => setTag(wTag, A.final(wTag)), 7300);
    M.add(qboxEl, { d: ['M 300 360 H 478 V 468 H 300 Z', 'M 300 360 H 540 V 468 H 300 Z'], duration: 480, ease: 'inOut(2)' }, 7350);
    M.add(qn, {
      n: 4,
      duration: 220,
      modifier: utils.round(0),
      onUpdate: () => (countEl.textContent = String(qn.n)),
    }, 7500);

    /* one message leaves for the owner */
    M.add(alertEl, { opacity: [0, 1], translateY: [14, 0], duration: 620, ease: snap }, 8300);

    /* the scene holds and lives, then the annotations dissolve and it replays */
    M.add(
      [
        ...Array.from(cam.querySelectorAll('.c-bone, .c-joint, .c-pbox, .p-tag')),
        qboxEl,
        chip,
        alertEl,
        walker,
      ],
      { opacity: 0, duration: 800, ease: 'linear' },
      20800,
    );

    once(cam, () => {
      /* the constant life of the frame */
      if (scanline) loops.push(animate(scanline, { top: ['-22%', '122%'], duration: 3600, loop: true, ease: 'linear' }));
      if (rec) loops.push(animate(rec, { opacity: [1, 0.12], duration: 640, alternate: true, loop: true, ease: 'inOutSine' }));
      const scanarm = cam.querySelector<SVGGElement>('[data-scanarm]');
      if (scanarm) loops.push(animate(scanarm, { rotate: [-2, 9], duration: 1300, alternate: true, loop: true, ease: 'inOutSine' }));
      const phoneEl = cam.querySelector<SVGRectElement>('[data-phone]');
      if (phoneEl) loops.push(animate(phoneEl, { translateY: [0, 1.4], duration: 900, alternate: true, loop: true, ease: 'inOutSine' }));
      const sways = cam.querySelectorAll<SVGGElement>('.c-sway');
      if (sways.length) {
        loops.push(animate(sways, { rotate: [-0.9, 0.9], duration: 2400, alternate: true, loop: true, ease: 'inOutSine', delay: stagger(500) }));
      }
      loops.push(M);
      M.play();
    });
  }

  const section = document.getElementById('soon');
  if (section) {
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        section.setAttribute('data-anim', '');
        const office = section.querySelector<HTMLElement>('[data-office]');
        const camWrap = section.querySelector<HTMLElement>('[data-cam-wrap]');
        if (office) armOffice(office);
        if (camWrap) armCam(camWrap);
        trackLoops(section);
      }
    } catch (err) {
      /* Motion is atmosphere; the copy is the point. Whatever failed, put the
         section back into its static, fully legible state. */
      section.removeAttribute('data-anim');
      console.warn('[echelon] soon-section motion unavailable', err);
    }
  }
</script>
