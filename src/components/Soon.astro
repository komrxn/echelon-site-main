  }

  /* the people: fat rounded capsule strokes — silhouettes with real limbs */
  .c-cap {
    stroke: rgba(244, 241, 232, 0.5);
    stroke-linecap: round;
    fill: none;
  }
  .p-q .c-cap,
  .p-q .c-caphead {
