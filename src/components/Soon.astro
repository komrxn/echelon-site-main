---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const s = dict.soon;
---

<!--
  WHAT'S NEXT — the only section on the page about the future, and it says so.
  Deep in the night world (03:00), between the ledger and the dawn seam: the
  machine building the next shift while the current one runs.

  Motion here is anime.js, not the page's reveal patterns — these two scenes are
  small mechanisms, not paragraphs arriving. The section stays honest about it
  the same way the rest of the page does: everything ships in its FINAL state,
  and the script hides-then-plays only after it has actually loaded (the
  [data-anim] attribute is set by the script itself). No JS, a failed import, or
  prefers-reduced-motion all land on the same fully-legible static frame.
-->
<section class="soon band on-ink" id="soon" data-shift="03:00" data-field-surface="0.45">
  <div class="page">
    <div class="soon__head" data-reveal="archive">
      <p class="label soon__label">{s.label}</p>
      <h2 class="title soon__title">{s.title}</h2>
      <p class="lead soon__lead">{s.lead}</p>
    </div>

    <!-- a) The virtual office: agents working, every one reporting to the hub. -->
    <article class="soon__feature">
      <div class="soon__copy" data-reveal="expand">
        <p class="soon__kicker sys">
          <span class="soon__badge">{s.badge}</span>
          {s.office.kicker}
        </p>
        <h3 class="soon__ftitle">{s.office.title}</h3>
        <p class="soon__ftext">{s.office.text}</p>
        <p class="note soon__fnote">{s.office.note}</p>
      </div>

      <div class="soon__visual soon__office" data-office>
        <svg class="soon__wires" data-wires aria-hidden="true"></svg>
        <div class="soon__agents">
          {
            s.office.agents.map((a) => (
              <div class="soon__agent" data-agent data-tone={a.tone}>
                <span class="soon__dot" data-dot aria-hidden="true" />
                <span class="soon__agent-name">{a.name}</span>
                <span class="soon__agent-state sys">{a.state}</span>
                <span class="soon__agent-task sys">{a.task}</span>
              </div>
            ))
          }
        </div>
        <div class="soon__hub" data-hub>
          <p class="soon__hub-name">
            {s.office.hubName}
            <span class="soon__hub-role sys">{s.office.hubRole}</span>
          </p>
          <p class="label soon__reports-label">{s.office.reportsLabel}</p>
          <ol class="soon__reports">
            {
              s.office.reports.map((r) => (
                <li class="soon__report" data-report>
                  <span class="soon__report-at sys">{r.at}</span>
                  <span class="soon__report-text">{r.text}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </article>

    <!-- b) AI video monitoring: the camera notices, the owner gets one message. -->
    <article class="soon__feature soon__feature--flip">
      <div class="soon__copy" data-reveal="expand">
        <p class="soon__kicker sys">
          <span class="soon__badge">{s.badge}</span>
          {s.cctv.kicker}
        </p>
        <h3 class="soon__ftitle">{s.cctv.title}</h3>
        <p class="soon__ftext">{s.cctv.text}</p>
        <p class="note soon__fnote">{s.cctv.note}</p>
      </div>

      <div class="soon__visual soon__camwrap" data-cam>
        <div class="soon__cam">
          <div class="soon__cam-top sys">
            <span class="soon__rec" data-rec aria-hidden="true"></span>
            <span>{s.cctv.rec}</span>
            <span class="soon__cam-name">{s.cctv.camName}</span>
            <span class="soon__cam-time">{s.cctv.camTime}</span>
          </div>
          <div class="soon__scene">
            <span class="soon__scanline" data-scanline aria-hidden="true"></span>
            <span class="soon__desk" aria-hidden="true"></span>
            <span class="soon__clerk" aria-hidden="true"></span>
            <div class="soon__queue" aria-hidden="true">
              {Array.from({ length: 6 }).map(() => <span class="soon__person" data-person />)}
            </div>
            <div class="soon__detect" data-detect>
              <span class="soon__detect-chip sys" data-chip>
                {s.cctv.queueLabel} · <span data-count>6</span>
              </span>
              <svg class="soon__detect-frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path data-detect-path d="M 2 2 H 98 V 98 H 2 Z" vector-effect="non-scaling-stroke"></path>
              </svg>
            </div>
          </div>
        </div>
        <div class="soon__alert" data-alert>
          <p class="label soon__alert-title">{s.cctv.alertTitle}</p>
          <p class="soon__alert-text">{s.cctv.alert}</p>
          <p class="soon__alert-meta sys">{s.cctv.alertMeta}</p>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .soon {
    padding-block: clamp(4.5rem, 12vh, 9rem);
    border-bottom: 1px solid var(--rule);
  }
  .soon__title {
    margin-top: 0.6rem;
    max-width: 18ch;
  }
  .soon__lead {
    margin-top: 1rem;
  }

  .soon__feature {
    margin-top: clamp(3rem, 8vh, 5.5rem);
    display: grid;
    gap: clamp(1.75rem, 4vh, 2.5rem);
    align-items: center;
  }
  @media (min-width: 62rem) {
    .soon__feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    .soon__feature--flip .soon__copy {
      order: 2;
    }
  }

  .soon__kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }
  .soon__badge {
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--signal-edge);
    color: var(--signal);
    background: var(--signal-wash);
    font-size: var(--step-micro);
  }
  .soon__ftitle {
    margin-top: 0.9rem;
    font-size: var(--step-head);
    line-height: var(--leading-title);
    letter-spacing: var(--track-title);
    font-weight: 620;
    max-width: 24ch;
  }
  .soon__ftext {
    margin-top: 0.9rem;
    max-width: var(--measure-tight);
    color: var(--ink-muted);
  }
  .soon__fnote {
    margin-top: 0.9rem;
  }

  /* ---- a) the office ---- */
  .soon__office {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
  }
  @media (min-width: 40rem) {
    .soon__office {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: clamp(2.25rem, 6vw, 4.5rem);
      align-items: center;
    }
  }
  .soon__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .soon__agents {
    display: grid;
    gap: clamp(0.8rem, 2vh, 1.1rem);
    position: relative;
  }
  .soon__agent {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 0.55rem;
    padding: 0.75rem 0.9rem 0.8rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .soon__dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    align-self: center;
  }
  .soon__agent[data-tone='review'] .soon__dot {
    background: var(--machine);
  }
  .soon__agent-name {
    font-weight: 600;
    color: var(--ink);
  }
  .soon__agent-state {
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }
  .soon__agent[data-tone='review'] .soon__agent-state {
    color: var(--signal);
  }
  .soon__agent-task {
    grid-column: 1 / -1;
    margin-top: 0.35rem;
    font-size: var(--step-micro);
    color: var(--machine);
  }

  .soon__hub {
    position: relative;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper-deep);
  }
  .soon__hub-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    font-weight: 620;
    color: var(--ink);
  }
  .soon__hub-role {
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }
  .soon__reports-label {
    margin-top: 1rem;
    color: var(--machine);
  }
  .soon__reports {
    margin-top: 0.5rem;
    display: grid;
  }
  .soon__report {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step-small);
    color: var(--ink-muted);
  }
  .soon__report-at {
    font-size: var(--step-micro);
    color: var(--machine);
    flex-shrink: 0;
  }

  /* ---- b) the camera ---- */
  .soon__cam {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--rule);
    background:
      repeating-linear-gradient(to right, transparent 0 calc(12.5% - 1px), rgba(244, 241, 232, 0.035) calc(12.5% - 1px) 12.5%),
      repeating-linear-gradient(to bottom, transparent 0 calc(20% - 1px), rgba(244, 241, 232, 0.035) calc(20% - 1px) 20%),
      #0a0a08;
    overflow: hidden;
  }
  .soon__cam-top {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.75rem;
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
    background: linear-gradient(to bottom, rgba(10, 10, 8, 0.85), transparent);
  }
  .soon__rec {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
  }
  .soon__cam-name {
    margin-left: auto;
  }
  .soon__scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .soon__scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: -22%;
    height: 16%;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(244, 241, 232, 0.045) 46%,
      rgba(244, 241, 232, 0.1) 52%,
      transparent
    );
    pointer-events: none;
  }
  .soon__desk {
    position: absolute;
    left: 6%;
    bottom: 12%;
    width: 24%;
    height: 13%;
    border: 1px solid var(--rule-strong);
    background: rgba(244, 241, 232, 0.04);
  }
  .soon__clerk {
    position: absolute;
    left: 14%;
    bottom: 25.5%;
    width: 4.2%;
    aspect-ratio: 10 / 21;
    border-radius: 999px 999px 4px 4px;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  .soon__queue {
    position: absolute;
    left: 39%;
    right: 10%;
    bottom: 13%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .soon__person {
    width: 5.5%;
    aspect-ratio: 10 / 21;
    border-radius: 999px 999px 4px 4px;
    background: color-mix(in srgb, var(--ink) 78%, transparent);
  }
  .soon__detect {
    position: absolute;
    left: 35.5%;
    right: 7%;
    top: 40%;
    bottom: 9%;
    z-index: 2;
  }
  .soon__detect-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .soon__detect-frame path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.5px;
  }
  .soon__detect-chip {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.45rem);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--signal);
    white-space: nowrap;
  }

  .soon__alert {
    margin-top: 0.9rem;
    max-width: 32rem;
    padding: 0.8rem 0.95rem 0.85rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper-deep);
  }
  @media (min-width: 40rem) {
    .soon__alert {
      margin-left: auto;
    }
  }
  .soon__alert-title {
    color: var(--machine);
  }
  .soon__alert-text {
    margin-top: 0.35rem;
    font-size: var(--step-small);
    color: var(--ink);
  }
  .soon__alert-meta {
    margin-top: 0.4rem;
    font-size: var(--step-micro);
    color: var(--machine);
  }

  /*
   * Initial states for the animated pieces. Gated on [data-anim], which ONLY the
   * section's own script sets, and only when motion is allowed — so no-JS, a
   * failed script and prefers-reduced-motion all read the static final frame
   * without a single rule of fallback CSS.
   */
  .soon[data-anim] .soon__agent,
  .soon[data-anim] .soon__hub,
  .soon[data-anim] .soon__report,
  .soon[data-anim] .soon__person,
  .soon[data-anim] .soon__detect-chip,
  .soon[data-anim] .soon__alert {
    opacity: 0;
  }
</style>

<script>
  import {
    animate,
    createTimeline,
    createDrawable,
    createMotionPath,
    cubicBezier,
    stagger,
    utils,
    type JSAnimation,
  } from 'animejs';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  /* mirrors --ease-enter / --ease-snap from the design tokens */
  const enter = cubicBezier(0.16, 1, 0.3, 1);
  const snap = cubicBezier(0.34, 1.4, 0.64, 1);

  /* Idle loops (pulses, scanline, REC blink) only tick while the section is on
     screen — the page has enough machinery running without an off-screen camera
     scanning for nobody. */
  const loops: JSAnimation[] = [];
  function trackLoops(section: HTMLElement) {
    let visible = true;
    const io = new IntersectionObserver((entries) => {
      const now = entries.some((e) => e.isIntersecting);
      if (now === visible) return;
      visible = now;
      for (const a of loops) (now ? a.resume : a.pause).call(a);
    });
    io.observe(section);
  }

  function once(el: Element, cb: () => void, threshold = 0.3) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        cb();
      },
      { threshold },
    );
    io.observe(el);
  }

  /* ---- a) the office: wires from every agent into the hub ---- */

  interface Wires {
    paths: SVGPathElement[];
    pulses: SVGCircleElement[];
    layout: () => void;
  }

  function buildWires(office: HTMLElement): Wires | null {
    const svg = office.querySelector<SVGSVGElement>('[data-wires]');
    const agents = Array.from(office.querySelectorAll<HTMLElement>('[data-agent]'));
    const hub = office.querySelector<HTMLElement>('[data-hub]');
    if (!svg || !hub || !agents.length) return null;

    const paths = agents.map(() => {
      const p = document.createElementNS(SVG_NS, 'path');
      p.setAttribute('fill', 'none');
      p.setAttribute('stroke-width', '1.5');
      p.style.stroke = 'var(--signal-edge)';
      svg.appendChild(p);
      return p;
    });
    const pulses = agents.map(() => {
      const c = document.createElementNS(SVG_NS, 'circle');
      c.setAttribute('r', '3');
      c.style.fill = 'var(--signal)';
      c.style.opacity = '0';
      svg.appendChild(c);
      return c;
    });

    const layout = () => {
      const fb = office.getBoundingClientRect();
      const hb = hub.getBoundingClientRect();
      agents.forEach((agent, i) => {
        const ab = agent.getBoundingClientRect();
        let d: string;
        if (hb.top >= ab.bottom - 4) {
          /* stacked layout: leave from the card's foot, arrive at the hub's head */
          const ax = ab.left + ab.width / 2 - fb.left;
          const ay = ab.bottom - fb.top;
          const bx = hb.left + (hb.width * (i + 1)) / (agents.length + 1) - fb.left;
          const by = hb.top - fb.top;
          const bend = Math.max(24, (by - ay) * 0.6);
          d = `M ${ax} ${ay} C ${ax} ${ay + bend}, ${bx} ${by - bend}, ${bx} ${by}`;
        } else {
          /* side-by-side: right edge of the card into the hub's left edge */
          const ax = ab.right - fb.left;
          const ay = ab.top + ab.height / 2 - fb.top;
          const bx = hb.left - fb.left;
          const by = hb.top + hb.height / 2 - fb.top + (i - (agents.length - 1) / 2) * 16;
          const bend = Math.max(28, (bx - ax) * 0.5);
          d = `M ${ax} ${ay} C ${ax + bend} ${ay}, ${bx - bend} ${by}, ${bx} ${by}`;
        }
        paths[i]!.setAttribute('d', d);
      });
    };

    layout();
    return { paths, pulses, layout };
  }

  function armOffice(office: HTMLElement, wires: Wires) {
    const agents = office.querySelectorAll<HTMLElement>('[data-agent]');
    const hub = office.querySelector<HTMLElement>('[data-hub]');
    const reports = office.querySelectorAll<HTMLElement>('[data-report]');
    const dots = office.querySelectorAll<HTMLElement>('[data-dot]');
    if (!hub) return;

    const drawables = wires.paths.map((p) => createDrawable(p)[0]!);
    for (const d of drawables) utils.set(d, { draw: '0 0' });

    let pulseAnims: JSAnimation[] = [];
    const startPulses = () => {
      pulseAnims = wires.paths.map((path, i) => {
        const mp = createMotionPath(path);
        const anim = animate(wires.pulses[i]!, {
          translateX: mp.translateX,
          translateY: mp.translateY,
          opacity: [
            { to: 0.95, duration: 140 },
            { to: 0.95, duration: 760 },
            { to: 0, duration: 200 },
          ],
          duration: 1100,
          ease: 'inOutSine',
          delay: 500 + i * 1400,
          loop: true,
          loopDelay: 2900,
        });
        loops.push(anim);
        return anim;
      });
    };

    /* Re-route the wires when the grid re-wraps. The travelling pulses hold a
       snapshot of the old geometry, so they are rebuilt on the new one. */
    let frame = 0;
    const ro = new ResizeObserver(() => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        wires.layout();
        if (!pulseAnims.length) return;
        for (const a of pulseAnims) {
          const at = loops.indexOf(a);
          if (at !== -1) loops.splice(at, 1);
          a.cancel();
        }
        startPulses();
      });
    });
    ro.observe(office);

    const tl = createTimeline({
      autoplay: false,
      defaults: { ease: enter, duration: 700 },
      onComplete: () => {
        loops.push(
          animate(dots, {
            scale: [1, 1.55],
            duration: 820,
            alternate: true,
            loop: true,
            ease: 'inOutSine',
            delay: stagger(260),
          }),
        );
        startPulses();
      },
    });
    tl.add(agents, { opacity: [0, 1], translateY: [18, 0], delay: stagger(140) })
      .add(hub, { opacity: [0, 1], translateY: [20, 0] }, '-=480')
      .add(drawables, { draw: '0 1', duration: 850, delay: stagger(150), ease: 'inOut(2)' }, '-=420')
      .add(reports, { opacity: [0, 1], translateX: [-12, 0], duration: 520, delay: stagger(170) }, '-=380');

    once(office, () => tl.play());
  }

  /* ---- b) the camera: the queue grows, the box notices, one message leaves ---- */

  function armCam(cam: HTMLElement) {
    const persons = cam.querySelectorAll<HTMLElement>('[data-person]');
    const boxPath = cam.querySelector<SVGPathElement>('[data-detect-path]');
    const chip = cam.querySelector<HTMLElement>('[data-chip]');
    const countEl = cam.querySelector<HTMLElement>('[data-count]');
    const alertEl = cam.querySelector<HTMLElement>('[data-alert]');
    const scanline = cam.querySelector<HTMLElement>('[data-scanline]');
    const rec = cam.querySelector<HTMLElement>('[data-rec]');
    if (!boxPath || !chip || !countEl || !alertEl) return;

    const drawable = createDrawable(boxPath)[0]!;
    utils.set(drawable, { draw: '0 0' });
    const count = { n: 0 };
    countEl.textContent = '0';

    const tl = createTimeline({
      autoplay: false,
      defaults: { ease: enter },
      onComplete: () => {
        const frame = boxPath.closest('svg');
        if (frame) {
          loops.push(
            animate(frame, {
              opacity: [1, 0.55],
              duration: 1150,
              alternate: true,
              loop: true,
              ease: 'inOutSine',
            }),
          );
        }
      },
    });
    tl.add(persons, {
      opacity: [0, 1],
      translateY: [12, 0],
      scale: [0.7, 1],
      duration: 420,
      delay: stagger(320),
      ease: snap,
    })
      .add(drawable, { draw: '0 1', duration: 700, ease: 'inOut(2)' }, '-=1400')
      .add(chip, { opacity: [0, 1], duration: 300 }, '-=1250')
      .add(
        count,
        {
          n: 6,
          duration: 1350,
          ease: 'linear',
          modifier: utils.round(0),
          onUpdate: () => {
            countEl.textContent = String(count.n);
          },
        },
        '-=1300',
      )
      .add(alertEl, { opacity: [0, 1], translateY: [14, 0], duration: 620, ease: snap }, '+=260');

    once(cam, () => {
      if (scanline) {
        loops.push(
          animate(scanline, { top: ['-22%', '122%'], duration: 3400, loop: true, ease: 'linear' }),
        );
      }
      if (rec) {
        loops.push(
          animate(rec, { opacity: [1, 0.12], duration: 640, alternate: true, loop: true, ease: 'inOutSine' }),
        );
      }
      tl.play();
    });
  }

  const section = document.getElementById('soon');
  if (section) {
    try {
      const office = section.querySelector<HTMLElement>('[data-office]');
      const cam = section.querySelector<HTMLElement>('[data-cam]');
      /* The wires exist in every mode — under reduced motion they are simply
         drawn in full, a diagram rather than a performance. */
      const wires = office ? buildWires(office) : null;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        /* static diagram: keep the wires routed across re-wraps, nothing plays */
        if (office && wires) new ResizeObserver(() => wires.layout()).observe(office);
      } else {
        section.setAttribute('data-anim', '');
        if (office && wires) armOffice(office, wires);
        if (cam) armCam(cam);
        trackLoops(section);
      }
    } catch (err) {
      /* Motion is atmosphere; the copy is the point. Whatever failed, put the
         section back into its static, fully legible state. */
      section.removeAttribute('data-anim');
      console.warn('[echelon] soon-section motion unavailable', err);
    }
  }
</script>
