---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const s = dict.soon;
---

<!--
  WHAT'S NEXT — the only section on the page about the future, and it says so.
  Deep in the night world (03:00), between the ledger and the dawn seam.

  Two drawn instruments, both choreographed rather than looping noise:

  a) the office floor plan LIVES — couriers stand up, carry their report down
     the corridor to the head office, hand it over and walk back while the
     others keep typing;

  b) the camera scene tells one story on a loop — silhouettes first, then the
     skeleton is built joint by joint over every person, then the system READS
     the pose (working / on the phone / walking / queued), a timer runs on the
     idle employee, the queue grows, and one message leaves for the owner.

  Everything ships in its FINAL state; the [data-anim] attribute — set only by
  this section's own script when motion is allowed — arms the hidden initial
  states. No JS, a failed import and prefers-reduced-motion all land on the
  same fully legible static frame.
-->
<section class="soon band on-ink" id="soon" data-shift="03:00" data-field-surface="0.45">
  <div class="page">
    <div class="soon__head" data-reveal="archive">
      <p class="label soon__label">{s.label}</p>
      <h2 class="title soon__title">{s.title}</h2>
      <p class="lead soon__lead">{s.lead}</p>
    </div>

    <!-- a) The virtual office: the staff at work, reports walked to the head office. -->
    <article class="soon__feature">
      <div class="soon__copy" data-reveal="expand">
        <p class="soon__kicker sys">
          <span class="soon__badge">{s.badge}</span>
          {s.office.kicker}
        </p>
        <h3 class="soon__ftitle">{s.office.title}</h3>
        <p class="soon__ftext">{s.office.text}</p>
        <p class="note soon__fnote">{s.office.note}</p>
      </div>

      <div class="soon__office" data-office>
        <div class="soon__plan">
          <div class="soon__plansvg">
            <svg viewBox="0 0 1000 620" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <!-- walls, drawn like a technical print -->
              <path class="o-wall" d="M12 12 H988 V608 H12 Z"></path>
              <path class="o-wall" d="M340 12 V90 M340 130 V288 M340 328 V486 M340 526 V608"></path>
              <path class="o-wall" d="M12 210 H340 M12 408 H340"></path>
              <path class="o-wall" d="M660 12 V150 M660 190 V440 M660 480 V608"></path>
              <path class="o-wall" d="M660 340 H988"></path>
              <path class="o-wall" d="M340 440 H470 M510 440 H660"></path>

              <!-- the vacancy: the constructor's empty plot -->
              <path class="o-dash" d="M684 366 H964 V584 H684 Z"></path>
              <path class="o-plus" d="M824 441 V469 M810 455 H838"></path>

              <!-- desks -->
              <g class="o-furn">
                <rect class="o-desk" x="80" y="65" width="150" height="34"></rect>
                <line class="o-screen" x1="140" y1="71" x2="170" y2="71"></line>
              </g>
              <g class="o-furn">
                <rect class="o-desk" x="80" y="263" width="150" height="34"></rect>
                <line class="o-screen" x1="140" y1="269" x2="170" y2="269"></line>
              </g>
              <g class="o-furn">
                <rect class="o-desk" x="80" y="462" width="150" height="34"></rect>
                <line class="o-screen" x1="140" y1="468" x2="170" y2="468"></line>
              </g>
              <g class="o-furn">
                <rect class="o-desk" x="400" y="478" width="160" height="34"></rect>
                <line class="o-screen" x1="465" y1="484" x2="495" y2="484"></line>
              </g>
              <g class="o-furn">
                <rect class="o-desk" x="730" y="120" width="200" height="40"></rect>
                <line class="o-screen" x1="810" y1="128" x2="850" y2="128"></line>
              </g>

              <!-- reports, laid on the head desk while a courier is there -->
              <rect class="o-deskpaper" data-deskpaper="rec" x="770" y="132" width="10" height="13"></rect>
              <rect class="o-deskpaper" data-deskpaper="coder" x="800" y="132" width="10" height="13"></rect>

              <!-- the seated staff -->
              <g class="o-fig" data-pop>
                <circle class="o-head" cx="155" cy="305" r="8"></circle>
                <rect class="o-body" x="144" y="315" width="22" height="30" rx="10"></rect>
              </g>
              <g class="o-fig" data-pop>
                <circle class="o-head" cx="155" cy="504" r="8"></circle>
                <rect class="o-body" x="144" y="514" width="22" height="30" rx="10"></rect>
              </g>
              <g class="o-fig o-fig--hub" data-pop>
                <circle class="o-head" cx="830" cy="180" r="9"></circle>
                <rect class="o-body" x="817" y="191" width="26" height="34" rx="12"></rect>
                <circle class="o-hubdot" cx="842" cy="170" r="3.5"></circle>
              </g>

              <!-- the couriers: they walk their reports over -->
              <g class="o-fig o-walk" data-courier="rec" data-pop>
                <g class="o-wi">
                  <line class="o-leg o-legA" x1="-4" y1="-11" x2="-4" y2="0"></line>
                  <line class="o-leg o-legB" x1="4" y1="-11" x2="4" y2="0"></line>
                  <rect class="o-wbody" x="-8.5" y="-30" width="17" height="20" rx="8"></rect>
                  <circle class="o-whead" cx="0" cy="-36" r="6.5"></circle>
                  <rect class="o-paper" x="9" y="-27" width="7" height="9"></rect>
                </g>
              </g>
              <g class="o-fig o-walk" data-courier="coder" data-pop>
                <g class="o-wi">
                  <line class="o-leg o-legA" x1="-4" y1="-11" x2="-4" y2="0"></line>
                  <line class="o-leg o-legB" x1="4" y1="-11" x2="4" y2="0"></line>
                  <rect class="o-wbody" x="-8.5" y="-30" width="17" height="20" rx="8"></rect>
                  <circle class="o-whead" cx="0" cy="-36" r="6.5"></circle>
                  <rect class="o-paper" x="9" y="-27" width="7" height="9"></rect>
                </g>
              </g>
            </svg>

            <!-- room labels ride the plan in every mode -->
            <div class="soon__labels" aria-hidden="true">
              <span class="o-lab" style="left:2.8%;top:3.2%">{s.office.rooms.recruiter}</span>
              <span class="o-lab" style="left:2.8%;top:35.2%">{s.office.rooms.content}</span>
              <span class="o-lab" style="left:2.8%;top:67.2%">{s.office.rooms.researcher}</span>
              <span class="o-lab" style="left:35.4%;top:73%">{s.office.rooms.coder}</span>
              <span class="o-lab o-lab--hub" style="left:67.4%;top:3.2%">
                {s.office.rooms.hub}
                <em>{s.office.hubRole}</em>
              </span>
              <span class="o-lab o-lab--vac" style="left:68.4%;top:76.6%;width:27.6%">{s.office.rooms.vacancy}</span>
            </div>
          </div>

          <!-- speech bubbles: who is doing what, right now -->
          <div class="soon__bubbles">
            <div class="o-bub" style="left:19.5%;top:39%">
              <b>{s.office.rooms.content}</b>
              <span class="o-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="o-text">{s.office.bubbles.content}</span>
            </div>
            <div class="o-bub" style="left:19.5%;top:71%">
              <b>{s.office.rooms.researcher}</b>
              <span class="o-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="o-text">{s.office.bubbles.researcher}</span>
            </div>
            <div class="o-bub" style="left:47%;top:74%">
              <b>{s.office.rooms.coder}</b>
              <span class="o-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="o-text">{s.office.bubbles.coder}</span>
            </div>
            <!-- handed-over reports: driven entirely by the courier timelines -->
            <div class="o-bub o-bub--hand" data-handoff="rec" style="left:63%;top:34%">
              <b>{s.office.rooms.hub}</b>
              <span class="o-text" style="opacity:1">{s.office.handoffs.recruiter}</span>
            </div>
            <div class="o-bub o-bub--hand" data-handoff="coder" style="left:63%;top:44%">
              <b>{s.office.rooms.hub}</b>
              <span class="o-text" style="opacity:1">{s.office.handoffs.coder}</span>
            </div>
          </div>
        </div>

        <div class="soon__reports">
          <p class="label soon__reports-label">{s.office.reportsLabel}</p>
          <ol class="soon__reports-list">
            {
              s.office.reports.map((r) => (
                <li class="soon__report" data-report>
                  <span class="soon__report-at sys">{r.at}</span>
                  <span class="soon__report-text">{r.text}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </article>

    <!-- b) AI video monitoring: skeletons built over people, poses read out loud. -->
    <article class="soon__feature">
      <div class="soon__copy" data-reveal="expand">
        <p class="soon__kicker sys">
          <span class="soon__badge">{s.badge}</span>
          {s.cctv.kicker}
        </p>
        <h3 class="soon__ftitle">{s.cctv.title}</h3>
        <p class="soon__ftext">{s.cctv.text}</p>
        <p class="note soon__fnote">{s.cctv.note}</p>
      </div>

      <div class="soon__camwrap" data-cam-wrap>
        <div class="soon__cam" data-cam>
          <div class="soon__cam-top sys">
            <span class="soon__rec" data-rec aria-hidden="true"></span>
            <span>{s.cctv.rec}</span>
            <span class="soon__cam-name">{s.cctv.camName}</span>
            <span class="soon__cam-time">{s.cctv.camTime}</span>
          </div>
          <span class="soon__scanline" data-scanline aria-hidden="true"></span>

          <svg class="soon__scene" viewBox="0 0 1000 562" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <line class="c-horizon" x1="0" y1="430" x2="1000" y2="430"></line>

            <!-- P2 · the second employee, sitting on a crate, phone at his face -->
            <g class="p-g" data-person="phone" transform="translate(690 414) scale(0.9)">
              <g class="c-fl">
                <rect class="c-crate" x="-12" y="0" width="42" height="30"></rect>
                <line class="c-cap c-cap--thigh" x1="0" y1="0" x2="20" y2="3"></line>
                <line class="c-cap c-cap--shin" x1="20" y1="3" x2="20" y2="28"></line>
                <line class="c-cap c-cap--foot" x1="20" y1="28" x2="28" y2="28"></line>
                <line class="c-cap c-cap--torso" x1="0" y1="0" x2="9" y2="-27"></line>
                <circle class="c-caphead" cx="15" cy="-36" r="8"></circle>
                <line class="c-cap c-cap--arm" x1="4" y1="-24" x2="14" y2="-8"></line>
                <line class="c-cap c-cap--arm" x1="7" y1="-22" x2="18" y2="-12"></line>
                <line class="c-cap c-cap--fore" x1="18" y1="-12" x2="24" y2="-26"></line>
                <rect class="c-phone" data-phone x="20.5" y="-35" width="7" height="11" rx="1.5"></rect>
              </g>
              <g class="c-sk">
                <line class="c-bone" x1="0" y1="0" x2="9" y2="-27"></line>
                <line class="c-bone" x1="9" y1="-27" x2="13" y2="-31"></line>
                <line class="c-bone" x1="0" y1="0" x2="20" y2="3"></line>
                <line class="c-bone" x1="20" y1="3" x2="20" y2="28"></line>
                <line class="c-bone" x1="7" y1="-22" x2="18" y2="-12"></line>
                <line class="c-bone" x1="18" y1="-12" x2="24" y2="-26"></line>
                <circle class="c-joint" cx="0" cy="0" r="3"></circle>
                <circle class="c-joint" cx="20" cy="3" r="2.6"></circle>
                <circle class="c-joint" cx="20" cy="28" r="2.4"></circle>
                <circle class="c-joint" cx="7" cy="-22" r="2.6"></circle>
                <circle class="c-joint" cx="18" cy="-12" r="2.4"></circle>
                <circle class="c-joint" cx="24" cy="-26" r="2.4"></circle>
                <circle class="c-joint" cx="15" cy="-33" r="2.8"></circle>
              </g>
              <path class="c-pbox" d="M -24 -54 H 42 V 34 H -24 Z"></path>
              <text
                class="p-tag"
                data-tag="phone"
                data-analyzing={s.cctv.status.analyzing}
                data-final={s.cctv.status.phone}
                x="-24"
                y="-64">{s.cctv.status.phone} · 4:07</text>
            </g>

            <!-- the queue: three people waiting, one more on his way -->
            <g class="p-g p-q" transform="translate(330 452)">
              <g class="c-sway">
                <line class="c-cap c-cap--leg" x1="-4" y1="-34" x2="-4" y2="0"></line>
                <line class="c-cap c-cap--leg" x1="4" y1="-34" x2="4" y2="0"></line>
                <line class="c-cap c-cap--torso" x1="0" y1="-32" x2="0" y2="-60"></line>
                <circle class="c-caphead" cx="0" cy="-70" r="8.5"></circle>
                <line class="c-cap c-cap--arm" x1="0" y1="-56" x2="-8" y2="-38"></line>
                <line class="c-cap c-cap--arm" x1="0" y1="-56" x2="8" y2="-38"></line>
              </g>
            </g>
            <g class="p-g p-q" transform="translate(388 452)">
              <g class="c-sway">
                <line class="c-cap c-cap--leg" x1="-4" y1="-33" x2="-4" y2="0"></line>
                <line class="c-cap c-cap--leg" x1="4" y1="-33" x2="4" y2="0"></line>
                <line class="c-cap c-cap--torso" x1="0" y1="-31" x2="0" y2="-58"></line>
                <circle class="c-caphead" cx="0" cy="-68" r="8"></circle>
                <line class="c-cap c-cap--fore" x1="-8" y1="-46" x2="7" y2="-43"></line>
                <line class="c-cap c-cap--fore" x1="8" y1="-47" x2="-7" y2="-42"></line>
              </g>
            </g>
            <g class="p-g p-q" transform="translate(446 452)">
              <g class="c-sway" style="transform: rotate(2.5deg)">
                <line class="c-cap c-cap--leg" x1="-5" y1="-34" x2="-3" y2="0"></line>
                <line class="c-cap c-cap--leg" x1="5" y1="-34" x2="7" y2="0"></line>
                <line class="c-cap c-cap--torso" x1="0" y1="-32" x2="2" y2="-61"></line>
                <circle class="c-caphead" cx="3" cy="-71" r="8.5"></circle>
                <line class="c-cap c-cap--arm" x1="1" y1="-56" x2="10" y2="-40"></line>
              </g>
            </g>
            <path class="c-qbox" data-qbox d="M 300 360 H 478 V 468 H 300 Z"></path>

            <!-- P1 · the cashier, working the till -->
            <g class="p-g" data-person="cashier" transform="translate(150 446)">
              <g class="c-fl">
                <line class="c-cap c-cap--leg" x1="-3" y1="-32" x2="-3" y2="0"></line>
                <line class="c-cap c-cap--leg" x1="3" y1="-32" x2="3" y2="0"></line>
                <line class="c-cap c-cap--torso" x1="0" y1="-32" x2="0" y2="-58"></line>
                <circle class="c-caphead" cx="0" cy="-68" r="8.5"></circle>
                <line class="c-cap c-cap--arm" x1="0" y1="-54" x2="-8" y2="-38"></line>
                <g class="c-scanarm" data-scanarm>
                  <line class="c-cap c-cap--arm" x1="0" y1="-54" x2="12" y2="-44"></line>
                  <line class="c-cap c-cap--fore" x1="12" y1="-44" x2="26" y2="-48"></line>
                  <line class="c-bone" x1="0" y1="-54" x2="12" y2="-44"></line>
                  <line class="c-bone" x1="12" y1="-44" x2="26" y2="-48"></line>
                  <circle class="c-joint" cx="12" cy="-44" r="2.6"></circle>
                  <circle class="c-joint" cx="26" cy="-48" r="2.4"></circle>
                </g>
              </g>
              <g class="c-sk">
                <line class="c-bone" x1="0" y1="-32" x2="0" y2="-58"></line>
                <line class="c-bone" x1="0" y1="-58" x2="0" y2="-62"></line>
                <line class="c-bone" x1="-3" y1="-32" x2="-3" y2="0"></line>
                <line class="c-bone" x1="3" y1="-32" x2="3" y2="0"></line>
                <line class="c-bone" x1="0" y1="-54" x2="-8" y2="-38"></line>
                <circle class="c-joint" cx="0" cy="-65" r="2.8"></circle>
                <circle class="c-joint" cx="0" cy="-54" r="3"></circle>
                <circle class="c-joint" cx="0" cy="-32" r="3"></circle>
                <circle class="c-joint" cx="-3" cy="-16" r="2.4"></circle>
                <circle class="c-joint" cx="3" cy="-16" r="2.4"></circle>
                <circle class="c-joint" cx="-8" cy="-38" r="2.4"></circle>
              </g>
              <path class="c-pbox" d="M -28 -84 H 40 V 4 H -28 Z"></path>
              <text
                class="p-tag"
                data-tag="cashier"
                data-analyzing={s.cctv.status.analyzing}
                data-final={s.cctv.status.working}
                x="-28"
                y="-92">{s.cctv.status.working}</text>
            </g>
            <g class="c-furn">
              <rect class="c-desk" x="60" y="398" width="190" height="52"></rect>
              <rect class="c-reg" x="168" y="386" width="28" height="12"></rect>
            </g>

            <!-- P3 · a customer walks in and joins the queue -->
            <g class="c-walk" transform="translate(0 405)">
              <g class="c-walk-x" data-rail>
                <g transform="scale(0.72)">
                <g class="c-bob">
                  <g class="c-arm c-arm-r" data-pivot>
                    <line class="c-cap c-cap--arm" x1="0" y1="-46" x2="0" y2="-18"></line>
                    <line class="c-bone" x1="0" y1="-46" x2="0" y2="-18"></line>
                    <circle class="c-joint" cx="0" cy="-18" r="3"></circle>
                    <g class="c-fore" data-pivot>
                      <line class="c-cap c-cap--fore" x1="0" y1="-18" x2="0" y2="6"></line>
                      <line class="c-bone" x1="0" y1="-18" x2="0" y2="6"></line>
                      <circle class="c-joint" cx="0" cy="6" r="2.6"></circle>
                    </g>
                  </g>
                  <g class="c-leg c-leg-r" data-pivot>
                    <line class="c-cap c-cap--thighw" x1="0" y1="0" x2="0" y2="34"></line>
                    <line class="c-bone" x1="0" y1="0" x2="0" y2="34"></line>
                    <circle class="c-joint" cx="0" cy="34" r="3"></circle>
                    <g class="c-shin" data-pivot>
                      <line class="c-cap c-cap--shinw" x1="0" y1="34" x2="0" y2="66"></line>
                      <line class="c-bone" x1="0" y1="34" x2="0" y2="66"></line>
                      <circle class="c-joint" cx="0" cy="66" r="2.6"></circle>
                    </g>
                  </g>
                  <g class="c-torso">
                    <line class="c-cap c-cap--torsow" x1="0" y1="0" x2="0" y2="-52"></line>
                    <line class="c-bone" x1="0" y1="0" x2="0" y2="-52"></line>
                    <circle class="c-joint" cx="0" cy="0" r="3.4"></circle>
                    <circle class="c-joint" cx="0" cy="-46" r="3.4"></circle>
                  </g>
                  <circle class="c-caphead c-caphead--w" cx="0" cy="-66" r="11"></circle>
                  <line class="c-bone" x1="0" y1="-52" x2="0" y2="-60"></line>
                  <circle class="c-joint" cx="0" cy="-63" r="3"></circle>
                  <g class="c-leg c-leg-l" data-pivot>
                    <line class="c-cap c-cap--thighw" x1="0" y1="0" x2="0" y2="34"></line>
                    <line class="c-bone" x1="0" y1="0" x2="0" y2="34"></line>
                    <circle class="c-joint" cx="0" cy="34" r="3"></circle>
                    <g class="c-shin" data-pivot>
                      <line class="c-cap c-cap--shinw" x1="0" y1="34" x2="0" y2="66"></line>
                      <line class="c-bone" x1="0" y1="34" x2="0" y2="66"></line>
                      <circle class="c-joint" cx="0" cy="66" r="2.6"></circle>
                    </g>
                  </g>
                  <g class="c-arm c-arm-l" data-pivot>
                    <line class="c-cap c-cap--arm" x1="0" y1="-46" x2="0" y2="-18"></line>
                    <line class="c-bone" x1="0" y1="-46" x2="0" y2="-18"></line>
                    <circle class="c-joint" cx="0" cy="-18" r="3"></circle>
                    <g class="c-fore" data-pivot>
                      <line class="c-cap c-cap--fore" x1="0" y1="-18" x2="0" y2="6"></line>
                      <line class="c-bone" x1="0" y1="-18" x2="0" y2="6"></line>
                      <circle class="c-joint" cx="0" cy="6" r="2.6"></circle>
                    </g>
                  </g>
                  <g class="c-tag-g">
                    <path class="c-pbox" d="M -34 -84 H 34 V 70 H -34 Z"></path>
                    <text
                      class="p-tag"
                      data-tag="walker"
                      data-walking={s.cctv.status.walking}
                      data-final={s.cctv.status.queued}
                      x="-34"
                      y="-92">{s.cctv.status.queued}</text>
                  </g>
                </g>
                </g>
              </g>
            </g>
          </svg>

          <span class="soon__detect-chip sys" data-chip>
            {s.cctv.queueLabel} · <span data-count>4</span>
          </span>
        </div>

        <div class="soon__alert" data-alert>
          <p class="label soon__alert-title">{s.cctv.alertTitle}</p>
          <p class="soon__alert-text">{s.cctv.alert}</p>
          <p class="soon__alert-meta sys">{s.cctv.alertMeta}</p>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .soon {
    padding-block: clamp(4.5rem, 12vh, 9rem);
    border-bottom: 1px solid var(--rule);
  }
  .soon__title {
    margin-top: 0.6rem;
    max-width: 18ch;
  }
  .soon__lead {
    margin-top: 1rem;
  }

  .soon__feature {
    margin-top: clamp(3.5rem, 10vh, 6.5rem);
  }
  .soon__kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
